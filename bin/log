#!/usr/bin/env bash
# Usage: log [-f] [N] [CATEGORY]
#   log           — interactive category picker
#   log 50        — last 50 lines
#   log -f        — follow
#   log -f 50     — last 50 lines + follow
#   log news      — all lines from news.log
#   log -f geo 50 — last 50 lines of geo.log + follow
#
# Categories: app, news, llm, geo, all (default)

LOGDIR="/sandbox/workspace/logs"
CATEGORY=""
FOLLOW=false
LINES=""

if [ $# -eq 0 ]; then
  echo "Log categories: [all] [app] [news] [llm] [geo]"
  printf "Choose: "
  read -r CATEGORY
  case "$CATEGORY" in
    all|app|news|llm|geo) ;;
    "") CATEGORY="all" ;;
    *) echo "Invalid category: $CATEGORY" >&2; exit 1 ;;
  esac
else
  CATEGORY="all"
fi

for arg in "$@"; do
  case "$arg" in
    -f) FOLLOW=true ;;
    app|news|llm|geo|all) CATEGORY="$arg" ;;
    *[!0-9]*) echo "Usage: log [-f] [N] [CATEGORY]" >&2; echo "Categories: app, news, llm, geo, all" >&2; exit 1 ;;
    *)  LINES="$arg" ;;
  esac
done

LOGFILE="$LOGDIR/$CATEGORY.log"

if [ ! -f "$LOGFILE" ]; then
  echo "Log file not found: $LOGFILE" >&2
  exit 1
fi

if $FOLLOW && [ -n "$LINES" ]; then
  tail -f -n "$LINES" "$LOGFILE"
elif $FOLLOW; then
  tail -f "$LOGFILE"
elif [ -n "$LINES" ]; then
  tail -n "$LINES" "$LOGFILE"
else
  cat "$LOGFILE"
fi
