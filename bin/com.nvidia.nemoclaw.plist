<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nvidia.nemoclaw</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Absolute path to nemoclaw — verify with: which nemoclaw -->
        <string>/Users/antesucue/.npm-global/bin/nemoclaw</string>
        <string>run</string>
        <string>--config</string>
        <string>/Users/antesucue/openclaw-agent/config.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/antesucue/openclaw-agent</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <!-- Restart on crash (non-zero exit), not on clean stop -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/antesucue/openclaw-agent/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/antesucue/openclaw-agent/launchd-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/antesucue</string>
    </dict>
</dict>
</plist>
