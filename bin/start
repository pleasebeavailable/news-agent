#!/usr/bin/env bash
# Start NemoClaw with nohup — survives SSH disconnects.
# Logs: tail -f /tmp/nemoclaw.log

SESSION_LOG="/tmp/nemoclaw.log"

# Kill any existing process
if [ -f /tmp/nemoclaw.lock ]; then
    OLD_PID=$(cat /tmp/nemoclaw.lock 2>/dev/null)
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        echo "Stopping existing NemoClaw (PID $OLD_PID)..."
        kill "$OLD_PID"
        sleep 2
    fi
fi

set -a
source /sandbox/.openclaw-data/.env 2>/dev/null || source /sandbox/workspace/.env 2>/dev/null
set +a

# Use venv Python — must match network policy binaries
PYTHON="/sandbox/.venv/bin/python3"
[ -x "$PYTHON" ] || PYTHON="python3"

nohup "$PYTHON" /sandbox/workspace/main.py >> "$SESSION_LOG" 2>&1 &
NEW_PID=$!
disown $NEW_PID

echo ""
echo "NemoClaw started (PID $NEW_PID) — survives SSH disconnect."
echo ""
echo "  Logs : tail -f $SESSION_LOG"
echo "  Stop : kill $NEW_PID  (or kill \$(cat /tmp/nemoclaw.lock))"
